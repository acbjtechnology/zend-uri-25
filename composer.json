{
    "name": "acbjtechnology/zend-uri-25",
    "description": "a component that aids in manipulating and validating \u00bb Uniform Resource Identifiers (URIs)",
    "license": "BSD-3-Clause",
    "keywords": [
        "zf2",
        "uri"
    ],
    "homepage": "https://github.com/acbjtechnology/zend-uri-25",
    "autoload": {
        "psr-4": {
            "Zend\\Uri\\": "src/"
        }
    },
    "require": {
        "php": ">=7.3",
        "zendframework/zend-escaper": "^2.5",
        "zendframework/zend-validator": "^2.5"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "main",
            "dev-develop": "52-2-1-dev"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZendTest\\Uri\\": "test/"
        }
    }
