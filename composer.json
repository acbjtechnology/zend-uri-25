{
    "name": "acbjtechnology/zend-uri-25",
    "description": "a component that aids in manipulating and validating \u00bb Uniform Resource Identifiers (URIs)",
    "license": "BSD-3-Clause",
    "keywords": [
        "zf2",
        "uri"
    ],
    "homepage": "https://github.com/acbjtechnology/zend-uri-25",
    "autoload": {
        "psr-4": {
            "Zend\\Uri\\": "src/"
        }
    },
    "require": {
        "php": ">=7.3",
        "acbjtechnology/zend-escaper-25": "@dev",
        "acbjtechnology/zend-validator-25": "@dev"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "main",
            "dev-develop": "52-2-1-dev"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZendTest\\Uri\\": "test/"
        }
    },
    "repositories" : [
        {
            "type":"package",
            "package": {
                "name": "acbjtechnology/zend-escaper-25",
                "version":"dev-main",
                "source": {
                    "url": "https://github.com/acbjtechnology/zend-escaper-25.git",
                    "type": "git",
                    "reference":"52-2-1-dev"
                },
                "autoload": {
                    "psr-4": {
                        "Zend\\Escaper\\": "src/"
                    }
                }
            }
        },
        {
            "type":"package",
            "package": {
                "name": "acbjtechnology/zend-validator-25",
                "version":"dev-main",
                "source": {
                    "url": "https://github.com/acbjtechnology/zend-validator-25.git",
                    "type": "git",
                    "reference":"main"
                },
                "autoload": {
                    "psr-4": {
                        "Zend\\Validator\\": "src/"
                    }
                }
            }
        }
    ]
}
